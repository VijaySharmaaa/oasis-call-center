# ─────────────────────────────────────────────────────────────────────────────
# Oasis Call Center — backend environment
#
# Copy to backend/.env and fill in. Never commit the real .env (it is gitignored).
#   cp backend/.env.example backend/.env
#
# Every variable below is read somewhere in backend/src. Values shown are
# working defaults for a production deploy; where the code has its own
# fallback it is noted as "code default".
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express app listens on. (code default: 3001)
PORT=3001
# "production" enables JSON logging, rotating log files, and strict rate limits.
# Anything else = development mode (pretty logs, relaxed limits).
# "test" additionally silences the console transport.
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. The database name is taken FROM THE URI —
# include it in the path, or the driver connects to the default db.
# Required — the server cannot start without it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing secret for all JWTs (login tokens AND short-lived export-download
# tokens). Use a long random string; rotating it invalidates every session.
#   openssl rand -base64 48
# Required.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account. These are compared directly against the login form — there is
# no admin record in the database, so changing them here changes the login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Supports a "*" wildcard in
# the subdomain position only (e.g. https://*.example.com matches one label).
# Requests with no Origin header (curl, server-to-server, the IVR webhook) are
# always allowed. (code default: http://localhost:5173)
#
# Must include whatever origin the frontend is served from. If you set
# VITE_API_URL in the frontend, the frontend's own origin goes here.
ALLOWED_ORIGINS=http://localhost:5173,http://<server-ip>,https://<your-domain>

# ── Telephony (BuzzDial) ─────────────────────────────────────────────────────
# Click-to-call API. Used by POST /api/calls/initiate.
BUZZDIAL_URL=https://buzzdial.io/api/clicktocall.php
BUZZDIAL_AUTH=061bce373430cab8
# Fallback agent name sent to BuzzDial when the caller has no name on their JWT.
BUZZDIAL_AGENT_NAME=Oasis Call Center

# ── Google Gemini ────────────────────────────────────────────────────────────
# API key for the Files API + generateContent. Without it the analysis worker
# and both taxonomy endpoints return an error but the app still runs.
GEMINI_API_KEY=

# Primary model for call analysis and taxonomy generation.
# NOTE: leave this set. If unset, geminiService falls back to gemini-1.5-flash
# while bugCategoryWorker falls back to gemini-2.5-flash — two different models
# for the same pipeline.
GEMINI_MODEL=gemini-2.5-flash

# Fallback model used ONLY when the primary returns 429 on that request.
# Set to "" to disable the fallback entirely. (v3.4.1)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# ── Cost reporting ───────────────────────────────────────────────────────────
# The daily report prices each analysis from the token counts Gemini returns.
# Rates ship as defaults in src/config/geminiPricing.js and are printed on the
# report itself, so a stale rate is visible rather than hidden inside a total.
#
# VERIFY THE DEFAULTS against https://ai.google.dev/pricing — Google changes
# Gemini pricing, and the defaults were written at one point in time. Override
# any of them here without a code change. USD per 1 MILLION tokens; `audio` is
# the input rate for AUDIO-modality tokens, which is what call recordings burn.
#
# GEMINI_PRICING={"gemini-2.5-flash":{"text":0.30,"audio":1.00,"output":2.50}}
GEMINI_PRICING=

# Show the report in a currency other than USD. Both must be set, and the rate
# is never inferred — with only the currency set the report stays in USD.
# GEMINI_COST_CURRENCY=INR
# GEMINI_COST_PER_USD=83.5
GEMINI_COST_CURRENCY=
GEMINI_COST_PER_USD=

# Cap each Gemini response for analysis (transcription + JSON). 8192 tokens
# ≈ 32 KB output, under Excel's per-cell 32,767-char limit. (v3.3.0)
# (code default: 8192, floor 1024)
GEMINI_MAX_OUTPUT_TOKENS=8192

# Cap for taxonomy-generation responses (/generate-categories,
# /generalise-categories). Decoupled from the analysis cap above because this
# output never goes to Excel — it's pure JSON parsed server-side. Large
# taxonomies with 100+ merged_from entries can easily exceed 8192. (v3.5.2)
# (code default: 32768, floor 8192)
GEMINI_TAXONOMY_MAX_TOKENS=32768

# Min ms between any two outgoing Gemini calls — a global rate-limit floor
# shared across all concurrent workers. 100 = 600 RPM ceiling. Tune to match
# your Gemini billing tier. (v3.4.0)  (code default: 200)
GEMINI_MIN_INTERVAL_MS=100

# Reject audio files larger than this (bytes) before the Gemini upload starts.
# 100 MB. Files above this fail permanently with no retry burn. Only enforced
# when the recording host reports Content-Length. (v3.4.0)
# (code default: 104857600, floor 1 MB)
GEMINI_MAX_AUDIO_BYTES=104857600

# ── Analysis worker ──────────────────────────────────────────────────────────
# How many recordings are analysed in parallel. Pair with
# GEMINI_MIN_INTERVAL_MS — at 10 concurrent and min-interval=100ms the gate has
# 7.5x headroom. (v3.4.0)  (code default: 5)
ANALYSIS_CONCURRENCY=10
# Worker tick interval in seconds. (code default: 5, floor 1)
ANALYSIS_POLL_SEC=5

# ── Category taxonomy ────────────────────────────────────────────────────────
# Master switch for the DYNAMIC taxonomy — the `call_categories` collection and
# everything that writes to it. OFF by default; only 1/true/yes/on turns it on.
# (code default: false)
#
# Two taxonomies exist, and only the dynamic one is gated here:
#   • HARDCODED — CATEGORIZATION_SCHEMA in geminiService.js (17 categories /
#     196 sub-categories, documented in docs/call-categories.md). Fills the
#     `category` / `sub_category` fields. ALWAYS ACTIVE, not affected by this
#     flag.
#   • DYNAMIC — the `call_categories` collection, Gemini-authored and free to
#     grow. Fills `call_category` / `call_sub_category`.
#
# With the flag OFF (default):
#   - the analysis prompt drops its taxonomy task entirely — Gemini is never
#     shown call_categories and never returns call_category, so it cannot
#     invent one;
#   - call_category / call_sub_category are derived server-side from the
#     hardcoded category / sub_category, and any pair not in
#     CATEGORIZATION_SCHEMA snaps to Uncategorised / "-";
#   - POST /api/analysis/generate-categories and /generalise-categories return
#     409 instead of rewriting the collection;
#   - the hourly worker still resolves bug_category (bugs have no hardcoded
#     schema) but no longer creates call_categories entries.
#
# Turned off after a 2026-08 audit: 292 invented category names had accumulated
# against a 17-category schema, and off-schema output had risen from 0.2% of
# calls in March to 15.9% in May. Existing call_categories documents are left
# untouched — the flag freezes the collection, it does not clear it.
#
# Set to true and restart the backend to re-enable.
DYNAMIC_CATEGORIES_ENABLED=false

# ── Logging ──────────────────────────────────────────────────────────────────
# Directory for rotating log files AND generated CSV exports (written to
# $LOG_DIR/exports). Only written when NODE_ENV=production; must be writable
# and persistent, or completed exports vanish on container restart.
# docker-compose sets this to /app/logs and mounts ./logs into it.
# (code default: backend/logs)
LOG_DIR=/app/logs

# Winston level: error | warn | info | http | verbose | debug | silly
# (code default: info in production, debug otherwise)
LOG_LEVEL=info

# ── Gmail — support mailbox ingestion (v3.6.0) ───────────────────────────────
# The email sync worker mirrors a Google Workspace mailbox into the `emails`
# collection, read-only, and serves it under /api/emails. Leave GMAIL_USER
# empty to disable the whole feature — the rest of the app runs unchanged.
#
# Access is READ-ONLY by design: the scope requested is gmail.readonly, so the
# server can list and read mail but can never send, modify, or delete it.

# The mailbox to mirror. Required to enable the feature.
GMAIL_USER=support@upessc.org

# ── Auth option 1: service account + domain-wide delegation (preferred) ──
# The service-account JSON key, as ONE LINE. Two accepted forms:
#   • base64 of the whole JSON  (recommended — no quoting or \n problems)
#         base64 -w0 service-account.json
#   • the raw JSON on a single line, starting with "{"
# Either way the code detects which it is.
#
# NEVER COMMIT THE REAL VALUE. This file is tracked by git; the real key belongs
# in backend/.env only. (An earlier revision of this file did leak the
# gmail-upessc@gmail-api-otr key — that key must be rotated in Google Cloud.)
GOOGLE_SERVICE_ACCOUNT_KEY=

# Alternative to the above: path to the JSON key file on disk. Ignored when
# GOOGLE_SERVICE_ACCOUNT_KEY is set. Must be inside the container if you mount
# it via docker-compose (e.g. /app/secrets/gmail-sa.json).
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
#
# ONE-TIME SETUP a Workspace super-admin must do, or every token request fails
# with 401 "unauthorized_client":
#   1. Google Cloud console → the key's project → enable the Gmail API.
#   2. admin.google.com → Security → Access and data control →
#      API controls → Domain-wide delegation → Add new.
#   3. Client ID = the `client_id` field from the JSON key
#      (for the existing key: 111776879778475843161)
#      OAuth scopes = https://www.googleapis.com/auth/gmail.readonly
#   4. Save, wait a few minutes, then: curl -H "Authorization: Bearer $TOKEN" \
#      localhost:3001/api/emails/sync-status

# ── Auth option 2: OAuth2 refresh token (when delegation can't be granted) ──
# Used only if the service-account vars above are empty. Create an OAuth client
# (type: Desktop or Web) in the same Cloud project, consent ONCE as the mailbox
# owner with the gmail.readonly scope, and paste the refresh token here.
# Publish the consent screen — refresh tokens issued by an app still in
# "Testing" status are revoked by Google after 7 days.
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=
GMAIL_OAUTH_REFRESH_TOKEN=

# ── Sync worker ──
# Master switch. "false" keeps the /api/emails endpoints serving whatever is
# already stored but stops polling Gmail. (code default: on when configured)
GMAIL_SYNC_ENABLED=true

# Seconds between sync passes. (code default: 60, floor 15)
GMAIL_POLL_SEC=60

# How far back the initial backfill reaches. 0 = the entire mailbox — note the
# support inbox runs ~13,000 messages/month, so a full history backfill is tens
# of thousands of API calls; it is resumable and rate-limited, but start narrow.
# Only affects the FIRST sync; after that, history.list picks up everything new.
# (code default: 30)
GMAIL_BACKFILL_DAYS=30

# Optional Gmail search string that overrides the date window above, e.g.
# "in:inbox -in:spam" or "after:2026/04/01". Same syntax as the Gmail searchbar.
GMAIL_SYNC_QUERY=

# Parallel messages.get calls. Gmail allows 250 quota units/sec/user and a get
# costs 5, so 8 leaves plenty of headroom. (code default: 8)
GMAIL_FETCH_CONCURRENCY=8

# Backfill list-pages (100 messages each) per tick — caps how much one tick can
# do so a large mailbox drains steadily instead of in one long burst.
# (code default: 5)
GMAIL_BACKFILL_PAGES_PER_TICK=5

# Per-message cap on stored body text/HTML. Mongo documents max out at 16 MB and
# a single HTML newsletter can be megabytes; anything longer is truncated with a
# marker. (code default: 200000, floor 1000)
GMAIL_MAX_BODY_CHARS=200000

# ── Email AI analysis (v3.6.0) ───────────────────────────────────────────────
# Runs every synced email through the SAME Gemini pipeline and the same
# CATEGORIZATION_SCHEMA the calls use, producing category, sub_category,
# summary, ai_insight, bugs and bug_category. Needs GEMINI_API_KEY above; with
# no key the worker logs a warning at startup and never runs.
#
# Model, fallback model, and the global rate-limit gate are shared with call
# analysis — see the GEMINI_* block. Two sentinel categories mirror the call
# side: "Email too Short" (no usable body, assigned without spending a Gemini
# call, the analogue of "Call too Short") and "Content Unclear" (the analogue of
# "Audio Unclear").

# Master switch. "false" keeps existing analysis queryable but queues nothing
# new. (code default: on when GEMINI_API_KEY is set)
EMAIL_ANALYSIS_ENABLED=true

# Emails analysed in parallel. Lower than ANALYSIS_CONCURRENCY because each job
# is a single generateContent call with no upload step, so it finishes fast and
# the queue drains without more workers. (code default: 4)
EMAIL_ANALYSIS_CONCURRENCY=4

# Worker tick interval in seconds. (code default: 10, floor 1)
EMAIL_ANALYSIS_POLL_SEC=10

# Bodies shorter than this (after quoted replies and signatures are stripped)
# skip Gemini entirely and are filed as "Email too Short". Set to 0 to analyse
# everything including blank mail. (code default: 15)
EMAIL_ANALYSIS_MIN_CHARS=15

# Prompt budget per email. Quoted threads and HTML newsletters are trimmed to
# this many characters — the request is nearly always in the first screenful.
# (code default: 12000, floor 500)
EMAIL_ANALYSIS_MAX_CHARS=12000

# Response cap. Far smaller than GEMINI_MAX_OUTPUT_TOKENS because there is no
# transcript to return — just the JSON verdict. (code default: 2048, floor 512)
EMAIL_ANALYSIS_MAX_TOKENS=2048
