# ─────────────────────────────────────────────────────────────────────────────
# Oasis Call Center — backend environment
#
# Copy to backend/.env and fill in. Never commit the real .env (it is gitignored).
#   cp backend/.env.example backend/.env
#
# Every variable below is read somewhere in backend/src. Values shown are
# working defaults for a production deploy; where the code has its own
# fallback it is noted as "code default".
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ───────────────────────────────────────────────────────────────────
# Port the Express app listens on. (code default: 3001)
PORT=3001
# "production" enables JSON logging, rotating log files, and strict rate limits.
# Anything else = development mode (pretty logs, relaxed limits).
# "test" additionally silences the console transport.
NODE_ENV=production

# ── Database ─────────────────────────────────────────────────────────────────
# MongoDB Atlas connection string. The database name is taken FROM THE URI —
# include it in the path, or the driver connects to the default db.
# Required — the server cannot start without it.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# ── Auth ─────────────────────────────────────────────────────────────────────
# Signing secret for all JWTs (login tokens AND short-lived export-download
# tokens). Use a long random string; rotating it invalidates every session.
#   openssl rand -base64 48
# Required.
JWT_SECRET=change-me-to-a-long-random-string

# Admin account. These are compared directly against the login form — there is
# no admin record in the database, so changing them here changes the login.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed browser origins. Supports a "*" wildcard in
# the subdomain position only (e.g. https://*.example.com matches one label).
# Requests with no Origin header (curl, server-to-server, the IVR webhook) are
# always allowed. (code default: http://localhost:5173)
#
# Must include whatever origin the frontend is served from. If you set
# VITE_API_URL in the frontend, the frontend's own origin goes here.
ALLOWED_ORIGINS=http://localhost:5173,http://<server-ip>,https://<your-domain>

# ── Telephony (BuzzDial) ─────────────────────────────────────────────────────
# Click-to-call API. Used by POST /api/calls/initiate.
BUZZDIAL_URL=https://buzzdial.io/api/clicktocall.php
BUZZDIAL_AUTH=061bce373430cab8
# Fallback agent name sent to BuzzDial when the caller has no name on their JWT.
BUZZDIAL_AGENT_NAME=Oasis Call Center

# ── Google Gemini ────────────────────────────────────────────────────────────
# API key for the Files API + generateContent. Without it the analysis worker
# and both taxonomy endpoints return an error but the app still runs.
GEMINI_API_KEY=

# Primary model for call analysis and taxonomy generation.
# NOTE: leave this set. If unset, geminiService falls back to gemini-1.5-flash
# while bugCategoryWorker falls back to gemini-2.5-flash — two different models
# for the same pipeline.
GEMINI_MODEL=gemini-2.5-flash

# Fallback model used ONLY when the primary returns 429 on that request.
# Set to "" to disable the fallback entirely. (v3.4.1)
GEMINI_FALLBACK_MODEL=gemini-2.5-flash-lite

# Cap each Gemini response for analysis (transcription + JSON). 8192 tokens
# ≈ 32 KB output, under Excel's per-cell 32,767-char limit. (v3.3.0)
# (code default: 8192, floor 1024)
GEMINI_MAX_OUTPUT_TOKENS=8192

# Cap for taxonomy-generation responses (/generate-categories,
# /generalise-categories). Decoupled from the analysis cap above because this
# output never goes to Excel — it's pure JSON parsed server-side. Large
# taxonomies with 100+ merged_from entries can easily exceed 8192. (v3.5.2)
# (code default: 32768, floor 8192)
GEMINI_TAXONOMY_MAX_TOKENS=32768

# Min ms between any two outgoing Gemini calls — a global rate-limit floor
# shared across all concurrent workers. 100 = 600 RPM ceiling. Tune to match
# your Gemini billing tier. (v3.4.0)  (code default: 200)
GEMINI_MIN_INTERVAL_MS=100

# Reject audio files larger than this (bytes) before the Gemini upload starts.
# 100 MB. Files above this fail permanently with no retry burn. Only enforced
# when the recording host reports Content-Length. (v3.4.0)
# (code default: 104857600, floor 1 MB)
GEMINI_MAX_AUDIO_BYTES=104857600

# ── Analysis worker ──────────────────────────────────────────────────────────
# How many recordings are analysed in parallel. Pair with
# GEMINI_MIN_INTERVAL_MS — at 10 concurrent and min-interval=100ms the gate has
# 7.5x headroom. (v3.4.0)  (code default: 5)
ANALYSIS_CONCURRENCY=10
# Worker tick interval in seconds. (code default: 5, floor 1)
ANALYSIS_POLL_SEC=5

# ── Logging ──────────────────────────────────────────────────────────────────
# Directory for rotating log files AND generated CSV exports (written to
# $LOG_DIR/exports). Only written when NODE_ENV=production; must be writable
# and persistent, or completed exports vanish on container restart.
# docker-compose sets this to /app/logs and mounts ./logs into it.
# (code default: backend/logs)
LOG_DIR=/app/logs

# Winston level: error | warn | info | http | verbose | debug | silly
# (code default: info in production, debug otherwise)
LOG_LEVEL=info