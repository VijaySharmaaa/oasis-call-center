# Dependencies
node_modules/

# Environment variables — never commit
.env

# Private keys — never commit
*.pem
.env.*
!.env.example

# Logs
logs/
*.log

# Build output
frontend/dist/
frontend/.vite/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Test coverage
coverage/

# Playwright
playwright-report/
test-results/

# Claude Code local settings
.claude/

# Misc
*.vsix

Temp/
# Playwright screenshots: regenerated on demand, never reviewed as text.
# Leading **/ matters: a pattern containing a slash is anchored to THIS file's
# directory, so a bare `visual/screens/` would have ignored a folder at the repo
# root and quietly committed 700KB of PNGs from frontend/visual/screens/.
**/visual/screens/
**/visual/.artifacts/
**/playwright-report/
**/test-results/

# Playwright screenshot harness — local verification only, never built or
# shipped. It is deliberately NOT a dependency of frontend/package.json
# either: the image builds with `npm ci`, so anything listed there is
# installed into the build whether the image needs it or not.
frontend/playwright.config.js
frontend/visual/
